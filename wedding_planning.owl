                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedMenu"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#containsDish"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
