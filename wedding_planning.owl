                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasIngredient"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#GlutenIngredient"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasGuest"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasDietaryRequirement"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#NutFreeRequirement"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedMenu"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#containsDish"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasIngredient"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#NutIngredient"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasGuest"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasDietaryRequirement"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#VegetarianRequirement"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
