<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/andra/ontologies/2026/10/untitled-ontology-6/"
     xml:base="http://www.semanticweb.org/andra/ontologies/2026/10/untitled-ontology-6/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:wedding-planning="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning"/>
    


    <!-- 
