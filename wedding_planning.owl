                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#GlutenFreeRequirement"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedMenu"/>
