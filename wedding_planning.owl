    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#containsDish -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#containsDish"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasBackupSpace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasBackupSpace"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCapacityCategory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCapacityCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCouple -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCouple">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasDietaryRequirement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasDietaryRequirement"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasFacility -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasFacility"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasGuest -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasGuest">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isGuestOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasHardRequirement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasHardRequirement"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasIngredient"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasPolicy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasPolicy"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSizeCategory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSizeCategory">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSpace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSpace"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSubEvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasSubEvent"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isWeddingOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#heldIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#heldIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isGuestOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isGuestOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isWeddingOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#isWeddingOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#offersMenu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#offersMenu"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#playsGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#playsGenre">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#playsGenre"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#subGenreOf"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#prefersGenre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#prefersGenre"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#providesEquipment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#providesEquipment"/>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedCaterer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedCaterer">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#assignedService"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedMenu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedMenu">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#subGenreOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#subGenreOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AccessibilityConflictPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AccessibilityConflictPlan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingPlan"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCouple"/>
                                <owl:someValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasHardRequirement"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WheelchairRequirement"/>
                                    </owl:Restriction>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasFacility"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WheelchairAccess"/>
                                    </owl:Restriction>
                                </owl:complementOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#ConflictingWeddingPlan"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholAllowedPolicy -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholAllowedPolicy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholPolicy"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#NoAlcoholPolicy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholConflictPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholConflictPlan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingPlan"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCouple"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasHardRequirement"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholFreeRequirement"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasPolicy"/>
                                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholAllowedPolicy"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCouple"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasHardRequirement"/>
                                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholRequiredRequirement"/>
                                                    </owl:Restriction>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasPolicy"/>
                                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#NoAlcoholPolicy"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#ConflictingWeddingPlan"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholFreeRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholFreeRequirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#HardRequirement"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholRequiredRequirement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholPolicy -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholPolicy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#VenuePolicy"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#MusicPolicy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholRequiredRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#AlcoholRequiredRequirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#HardRequirement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CapacityConflictPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CapacityConflictPlan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingPlan"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#LargeWedding"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCapacityCategory"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:unionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#MediumSize"/>
                                                            <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#SmallSize"/>
                                                        </owl:unionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#MediumWedding"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasCapacityCategory"/>
                                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#SmallSize"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#ConflictingWeddingPlan"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CateringService -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CateringService">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Service"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Ceremony -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Ceremony">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingSubEvent"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Reception"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CeremonySpace -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CeremonySpace">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Space"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CompleteWeddingPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#CompleteWeddingPlan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingPlan"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedVenue"/>
                                        <owl:someValuesFrom>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasFacility"/>
                                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#ParkingFacility"/>
                                            </owl:Restriction>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#assignedService"/>
                                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                                        <owl:onClass rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#SecurityStaff"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasWedding"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#LargeWedding"/>
                                    </owl:Restriction>
                                </owl:complementOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#assignedService"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Officiant"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#assignedService"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#Photographer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#selectedCaterer"/>
