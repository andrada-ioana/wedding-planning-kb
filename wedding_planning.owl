                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#hasGuest"/>
                                                <owl:someValuesFrom>
                                                    <owl:Restriction>
