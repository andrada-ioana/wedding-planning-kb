    <!-- http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#DietaryConflictPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#DietaryConflictPlan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#WeddingPlan"/>
