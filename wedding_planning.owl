<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning"
         xmlns="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning#">

<owl:Ontology rdf:about="http://www.semanticweb.org/vu/ontologies/2026/wedding-planning"/>

<owl:ObjectProperty rdf:about="#assignedService"/>

<owl:ObjectProperty rdf:about="#containsDish"/>

<owl:ObjectProperty rdf:about="#hasBackupSpace"/>

<owl:ObjectProperty rdf:about="#hasCapacityCategory">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCouple">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDietaryRequirement"/>

<owl:ObjectProperty rdf:about="#hasFacility"/>

<owl:ObjectProperty rdf:about="#hasGuest">
  <owl:inverseOf rdf:resource="#isGuestOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isGuestOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasHardRequirement"/>

<owl:ObjectProperty rdf:about="#hasIngredient"/>

<owl:ObjectProperty rdf:about="#hasPolicy"/>

<owl:ObjectProperty rdf:about="#hasSizeCategory">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSpace"/>

<owl:ObjectProperty rdf:about="#hasSubEvent"/>

<owl:ObjectProperty rdf:about="#hasWedding">
  <owl:inverseOf rdf:resource="#isWeddingOf"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isWeddingOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#heldIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#offersMenu"/>

<owl:ObjectProperty rdf:about="#playsGenre">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#playsGenre"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#subGenreOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subGenreOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefersGenre"/>

<owl:ObjectProperty rdf:about="#providesEquipment"/>

<owl:ObjectProperty rdf:about="#selectedCaterer">
  <rdfs:subPropertyOf rdf:resource="#assignedService"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#selectedMenu">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#selectedVenue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#AccessibilityConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasWedding"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasCouple"/>
              <owl:someValuesFrom>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasHardRequirement"/>
                  <owl:someValuesFrom rdf:resource="#WheelchairRequirement"/>
                </owl:Restriction>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedVenue"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:complementOf>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasFacility"/>
                  <owl:someValuesFrom rdf:resource="#WheelchairAccess"/>
                </owl:Restriction>
              </owl:complementOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#WheelchairRequirement">
  <rdfs:subClassOf rdf:resource="#HardRequirement"/>
</owl:Class>

<owl:Class rdf:about="#WheelchairAccess">
  <rdfs:subClassOf rdf:resource="#Facility"/>
</owl:Class>

<owl:Class rdf:about="#WeddingPlan"/>

<owl:Class rdf:about="#ConflictingWeddingPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AccessibilityConflictPlan"/>
        <rdf:Description rdf:about="#AlcoholConflictPlan"/>
        <rdf:Description rdf:about="#CapacityConflictPlan"/>
        <rdf:Description rdf:about="#DietaryConflictPlan"/>
        <rdf:Description rdf:about="#KitchenConflictPlan"/>
        <rdf:Description rdf:about="#MusicConflictPlan"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#WeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#AlcoholAllowedPolicy">
  <rdfs:subClassOf rdf:resource="#AlcoholPolicy"/>
  <owl:disjointWith rdf:resource="#NoAlcoholPolicy"/>
</owl:Class>

<owl:Class rdf:about="#AlcoholPolicy">
  <rdfs:subClassOf rdf:resource="#VenuePolicy"/>
  <owl:disjointWith rdf:resource="#MusicPolicy"/>
</owl:Class>

<owl:Class rdf:about="#NoAlcoholPolicy">
  <rdfs:subClassOf rdf:resource="#AlcoholPolicy"/>
</owl:Class>

<owl:Class rdf:about="#AlcoholConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasCouple"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasHardRequirement"/>
                          <owl:someValuesFrom rdf:resource="#AlcoholFreeRequirement"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedVenue"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasPolicy"/>
                      <owl:someValuesFrom rdf:resource="#AlcoholAllowedPolicy"/>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasCouple"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasHardRequirement"/>
                          <owl:someValuesFrom rdf:resource="#AlcoholRequiredRequirement"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedVenue"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasPolicy"/>
                      <owl:someValuesFrom rdf:resource="#NoAlcoholPolicy"/>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#AlcoholFreeRequirement">
  <rdfs:subClassOf rdf:resource="#HardRequirement"/>
  <owl:disjointWith rdf:resource="#AlcoholRequiredRequirement"/>
</owl:Class>

<owl:Class rdf:about="#AlcoholRequiredRequirement">
  <rdfs:subClassOf rdf:resource="#HardRequirement"/>
</owl:Class>

<owl:Class rdf:about="#HardRequirement">
  <rdfs:subClassOf rdf:resource="#Requirement"/>
</owl:Class>

<owl:Class rdf:about="#VenuePolicy"/>

<owl:Class rdf:about="#MusicPolicy">
  <rdfs:subClassOf rdf:resource="#VenuePolicy"/>
</owl:Class>

<owl:Class rdf:about="#CapacityConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom rdf:resource="#LargeWedding"/>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedVenue"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasCapacityCategory"/>
                      <owl:someValuesFrom>
                        <owl:Class>
                          <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="#MediumSize"/>
                            <rdf:Description rdf:about="#SmallSize"/>
                          </owl:unionOf>
                        </owl:Class>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom rdf:resource="#MediumWedding"/>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedVenue"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasCapacityCategory"/>
                      <owl:someValuesFrom rdf:resource="#SmallSize"/>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#LargeWedding">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Wedding"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSizeCategory"/>
          <owl:someValuesFrom rdf:resource="#LargeSize"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Wedding"/>
</owl:Class>

<owl:Class rdf:about="#MediumSize">
  <rdfs:subClassOf rdf:resource="#SizeCategory"/>
</owl:Class>

<owl:Class rdf:about="#SmallSize">
  <rdfs:subClassOf rdf:resource="#SizeCategory"/>
</owl:Class>

<owl:Class rdf:about="#MediumWedding">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Wedding"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasSizeCategory"/>
          <owl:someValuesFrom rdf:resource="#MediumSize"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Wedding"/>
</owl:Class>

<owl:Class rdf:about="#CateringService">
  <rdfs:subClassOf rdf:resource="#Service"/>
</owl:Class>

<owl:Class rdf:about="#Service"/>

<owl:Class rdf:about="#Ceremony">
  <rdfs:subClassOf rdf:resource="#WeddingSubEvent"/>
  <owl:disjointWith rdf:resource="#Reception"/>
</owl:Class>

<owl:Class rdf:about="#WeddingSubEvent"/>

<owl:Class rdf:about="#Reception">
  <rdfs:subClassOf rdf:resource="#WeddingSubEvent"/>
</owl:Class>

<owl:Class rdf:about="#CeremonySpace">
  <rdfs:subClassOf rdf:resource="#Space"/>
</owl:Class>

<owl:Class rdf:about="#Space"/>

<owl:Class rdf:about="#CompleteWeddingPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedVenue"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasFacility"/>
                      <owl:someValuesFrom rdf:resource="#ParkingFacility"/>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#assignedService"/>
                  <owl:onClass rdf:resource="#SecurityStaff"/>
                  <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:complementOf>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom rdf:resource="#LargeWedding"/>
                </owl:Restriction>
              </owl:complementOf>
            </owl:Class>
          </owl:unionOf>
        </owl:Class>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#assignedService"/>
          <owl:someValuesFrom rdf:resource="#Officiant"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#assignedService"/>
          <owl:someValuesFrom rdf:resource="#Photographer"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedCaterer"/>
          <owl:someValuesFrom rdf:resource="#CateringService"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedVenue"/>
          <owl:someValuesFrom rdf:resource="#Venue"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#WeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#ParkingFacility">
  <rdfs:subClassOf rdf:resource="#Facility"/>
</owl:Class>

<owl:Class rdf:about="#SecurityStaff">
  <rdfs:subClassOf rdf:resource="#Service"/>
</owl:Class>

<owl:Class rdf:about="#Officiant">
  <rdfs:subClassOf rdf:resource="#Service"/>
</owl:Class>

<owl:Class rdf:about="#Photographer">
  <rdfs:subClassOf rdf:resource="#Service"/>
</owl:Class>

<owl:Class rdf:about="#Venue"/>

<owl:Class rdf:about="#DietaryConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasGuest"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasDietaryRequirement"/>
                          <owl:someValuesFrom rdf:resource="#GlutenFreeRequirement"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedMenu"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#containsDish"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasIngredient"/>
                          <owl:someValuesFrom rdf:resource="#GlutenIngredient"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasGuest"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasDietaryRequirement"/>
                          <owl:someValuesFrom rdf:resource="#NutFreeRequirement"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedMenu"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#containsDish"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasIngredient"/>
                          <owl:someValuesFrom rdf:resource="#NutIngredient"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasWedding"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#hasGuest"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasDietaryRequirement"/>
                          <owl:someValuesFrom rdf:resource="#VegetarianRequirement"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#selectedMenu"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#containsDish"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#hasIngredient"/>
                          <owl:someValuesFrom rdf:resource="#MeatIngredient"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#KitchenConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedCaterer"/>
          <owl:someValuesFrom rdf:resource="#OnSiteCookingCatering"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedVenue"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:complementOf>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasFacility"/>
                  <owl:someValuesFrom rdf:resource="#OnSiteKitchen"/>
                </owl:Restriction>
              </owl:complementOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

<owl:Class rdf:about="#MusicConflictPlan">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#WeddingPlan"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#assignedService"/>
          <owl:someValuesFrom>
            <owl:Class>
