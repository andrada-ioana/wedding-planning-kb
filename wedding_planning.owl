            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#selectedVenue"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasPolicy"/>
              <owl:someValuesFrom rdf:resource="#NoLateNightMusicPolicy"/>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#ConflictingWeddingPlan"/>
</owl:Class>

